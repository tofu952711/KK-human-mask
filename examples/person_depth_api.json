{
  "1": {
    "class_type": "NellyVD_LoadVideo",
    "inputs": {
      "video": "your_video.mp4"
    }
  },
  "2": {
    "class_type": "NellyVD_PersonVideo",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "device": "cuda",
      "depth_precision": "280",
      "max_resolution": 0,
      "invert": false,
      "blur": "关闭"
    }
  },
  "3": {
    "class_type": "NellyVD_SaveVideo",
    "inputs": {
      "video": [
        "2",
        0
      ],
      "filename_prefix": "VideoDepth/person_depth"
    }
  },
  "4": {
    "class_type": "NellyVD_SaveVideo",
    "inputs": {
      "video": [
        "2",
        1
      ],
      "filename_prefix": "VideoDepth/person_mask"
    }
  }
}